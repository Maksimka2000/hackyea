# Copy to .env (git-ignored) next to docker-compose.yml. Every value is optional for local development.
HUBMI_DB_PASSWORD=change-me
# 32+ characters, e.g. openssl rand -base64 48
HUBMI_JWT_SECRET=
# Random string mixed into the hash of client addresses
HUBMI_CLIENT_KEY_SALT=
# Seed the demo accounts and list them on the simulated Profil Zaufany screen
HUBMI_SEED_DEMO_ACCOUNTS=true
# Matching requests per minute per client
HUBMI_MATCH_RATE_LIMIT=20
