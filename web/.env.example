# Copy to .env.local (git-ignored) and adjust.

# Backend address for the Next.js server: the /api proxy and server-side calls.
# docker compose -f server/docker-compose.hubmi.yml up  ->  http://localhost:8081
API_ORIGIN=http://localhost:8081

# "mock" serves fixtures shaped like the API contract; "live" calls the backend.
# NEXT_PUBLIC_API_MODE is the default for every feature; the per-feature values override it.
NEXT_PUBLIC_API_MODE=mock

# Implemented by the backend today:
NEXT_PUBLIC_API_MODE_MATCHING=live
NEXT_PUBLIC_API_MODE_INNOVATION_DETAIL=live

# No backend endpoint yet (home examples, related solutions, submissions). The mock data for the lists still uses
# the old slug ids, so while the detail page is live those cards cannot open a real card until the mocks are re-keyed.
NEXT_PUBLIC_API_MODE_INNOVATION_LIST=mock
NEXT_PUBLIC_API_MODE_SUBMISSIONS=mock

# Browser calls use this same-origin path (proxied to API_ORIGIN by next.config.ts).
NEXT_PUBLIC_API_BASE_URL=/api
