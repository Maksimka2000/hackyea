{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Match": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Persistence": {
    "MigrateOnStartup": false,
    "SeedSampleLibrary": false
  }
}
